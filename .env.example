# Environment variables read by the app (app.py, dashboard.py, utils.py) and
# the seed scripts. Copy to .env and fill in, or set them in your hosting
# platform. The app does not load .env itself — export the variables (e.g.
# `set -a; source .env; set +a`) or let your platform inject them.
# All values below are placeholders. Never commit real secrets.

# --- Runtime mode -----------------------------------------------------------
# "development" generates a random dashboard secret key if none is set and
# opens the /chat test page without login. Anything else = production rules.
APP_ENV=production
# 1 = Flask debug / auto-reload for `python app.py`. Never enable in production.
FLASK_DEBUG=0

# --- Required in production -------------------------------------------------
# OpenAI API key (required — the app will not start without it).
OPENAI_API_KEY=sk-your-openai-key
# SQLAlchemy URL. postgres:// is rewritten to postgresql://. Defaults to sqlite:///app.db.
DATABASE_URL=postgresql://user:password@localhost:5432/ai_receptionist
# Signs dashboard session cookies. Required unless APP_ENV=development.
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
DASHBOARD_SECRET_KEY=replace-with-a-long-random-string
# Shared secret for the /tasks/* cron endpoints, sent as the X-Reminder-Secret
# header. If unset, those endpoints reject every request.
REMINDER_SECRET=replace-with-a-long-random-string

# --- Twilio (WhatsApp) ------------------------------------------------------
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Also used to verify X-Twilio-Signature on /whatsapp. If unset, inbound
# webhooks are rejected unless ALLOW_UNSIGNED_WEBHOOKS=1.
TWILIO_AUTH_TOKEN=your-twilio-auth-token
# Default sender for outbound messages (clinics can override with their own number).
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# 1 = accept unsigned /whatsapp webhooks when TWILIO_AUTH_TOKEN is unset.
# Local testing only.
ALLOW_UNSIGNED_WEBHOOKS=0

# --- Google Calendar --------------------------------------------------------
# Fallback calendar ID for clinics without their own (default: primary).
GOOGLE_CALENDAR_ID=primary
# Service-account credentials: either the JSON content inline...
GOOGLE_SERVICE_ACCOUNT_JSON=
# ...or a path to the JSON key file (used when GOOGLE_SERVICE_ACCOUNT_JSON is empty).
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json

# --- Staff dashboard --------------------------------------------------------
# Comma-separated staff emails allowed into the admin billing pages.
# Empty = no admins.
DASHBOARD_ADMIN_EMAILS=admin@example.com

# --- Optional monitoring / alerts -------------------------------------------
SENTRY_DSN=
# Telegram bot used for failure alerts, daily summaries and dashboard feedback.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- seed_staff.py only (create a dashboard login) --------------------------
# Anything left unset is prompted for when run in a terminal.
# There is no default password; minimum length is 12 characters.
STAFF_EMAIL=owner@example.com
STAFF_FULL_NAME=Clinic Owner
STAFF_CLINIC_ID=1
STAFF_PASSWORD=
